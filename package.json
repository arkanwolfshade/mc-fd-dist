{
  "name": "mc-fd-dist",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Shift tracker that replaces the MC-FD and MC-Dist paper sheets at the food bank.",
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "start": "node dist/server/main.js",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "account": "tsx server/cli/account.ts",
    "test:e2e": "vite build && playwright test",
    "demo": "vite build && tsx e2e/demo.ts",
    "docs:screenshots": "vite build && tsx e2e/screenshots.ts",
    "docs:pdf": "tsx tools/guides-pdf.ts",
    "docs:check": "tsx tools/check-docs.ts",
    "licenses:check": "tsx tools/check-licenses.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,css,html,yaml,yml}": "prettier --write",
    "*.{ts,tsx,js,mjs}": "oxlint --deny-warnings"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "argon2": "^0.45.2",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.8",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "marked": "^18.1.3",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
