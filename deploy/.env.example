# Copy to .env on the server and fill in. Never commit the filled-in copy.
# Keep it readable by its owner only: chmod 600 .env

# The published container image to run.
APP_IMAGE=ghcr.io/arkanwolfshade/mc-fd-dist:latest

# The hostname stations use. Its DNS record must point at the server before starting,
# so that Caddy can obtain a certificate.
SITE_ADDRESS=shifts.example.org

# Receives certificate expiry warnings from Let's Encrypt.
ACME_EMAIL=someone@example.org

TIME_ZONE=America/Phoenix

# Where nightly backups go, and a key that can only add backups there.
BACKUP_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
